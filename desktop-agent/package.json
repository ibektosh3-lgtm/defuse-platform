{
  "name": "cybernet-agent",
  "version": "1.0.29",
  "description": "CyberNet Desktop Agent — kompyuter klubi PC uchun kiosk launcher",
  "main": "main.js",
  "author": "CyberNet",
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "watchdog": "node watchdog.js",
    "obfuscate": "node scripts/obfuscate-renderer.js",
    "dist:win": "node scripts/obfuscate-renderer.js && electron-builder --win nsis --x64 && git checkout renderer/index.html",
    "dist:win-portable": "electron-builder --win portable --x64",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "axios": "^1.17.0",
    "electron-updater": "^6.8.9",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^25.1.8",
    "javascript-obfuscator": "^5.5.0"
  },
  "build": {
    "appId": "uz.cybernet.agent",
    "productName": "CyberNet Agent",
    "copyright": "Copyright © 2026 CyberNet",
    "files": [
      "main.js",
      "watchdog.js",
      "config.json",
      "renderer/**/*",
      "windows-lockdown/**/*",
      "!node_modules/.cache",
      "!**/*.md"
    ],
    "extraResources": [
      {
        "from": "windows-lockdown",
        "to": "lockdown",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "config.json",
        "to": "config.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator",
      "artifactName": "CyberNet-Agent-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CyberNet Agent",
      "runAfterFinish": false
    },
    "portable": {
      "artifactName": "CyberNet-Agent-Portable-${version}.exe"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "publish": {
      "provider": "generic",
      "url": "https://example.com/downloads/"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    }
  }
}
